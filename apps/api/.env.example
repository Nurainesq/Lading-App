# Copy to .env and fill in. Never commit the filled-in file.

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lading?schema=public

# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=

# --- Escrow ------------------------------------------------------------------
# `mock` runs the full journey in memory, with no WeWire credentials needed.
# Switch to `wewire` once the keys below are filled in.
ESCROW_PROVIDER=mock

# From the WeWire dashboard: Settings → Developers.
# A sk_test_ key targets the sandbox; sk_live_ targets production. The base URL
# is inferred from the key prefix, so leave WEWIRE_BASE_URL unset unless you
# have a reason to override it.
WEWIRE_API_KEY=
WEWIRE_BASE_URL=
# The sub-customer under which per-deal escrow accounts are issued.
WEWIRE_ESCROW_SUBCUSTOMER_ID=

# Standard Webhooks signing secret, whsec_-prefixed. Set this even on the mock
# provider: without it the webhook endpoint refuses every delivery, so funding
# can never complete. Generate one for local use with:
#   echo "whsec_$(openssl rand -base64 32)"
WEWIRE_WEBHOOK_SECRET=

# --- Sign-in codes -----------------------------------------------------------
# `log` prints the code to the server log — development only, and rejected at
# boot when NODE_ENV=production. `twilio` sends it for real.
OTP_DELIVERY=log

# Twilio console → Account Info. TWILIO_FROM is either a Twilio number in E.164
# (+15005550006) or a Messaging Service SID (MG…). Prefer the Messaging Service:
# it picks a compliant sender per country, which matters for Ghana and the UAE.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Document storage --------------------------------------------------------
# `disk` writes to the local filesystem — development only, and rejected at boot
# when NODE_ENV=production. `s3` uses object storage.
STORAGE_DRIVER=disk
STORAGE_DISK_ROOT=./.storage

# Any S3-compatible store: AWS S3, Cloudflare R2, MinIO, Spaces. The bucket must
# block public access and should have versioning on — these are the documents a
# release is decided against.
S3_BUCKET=
S3_REGION=us-east-1
# Set only for a non-AWS endpoint.
S3_ENDPOINT=
# Omit both to use the ambient credential chain (instance role, env).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
